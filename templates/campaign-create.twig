{% extends "layout.twig" %}

{% block title %}Créer un Spreadly - Spreadly{% endblock %}

{% block font_size %}16px{% endblock %}

{% block extra_styles %}
.container-fluid {
    background-color: rgba(255, 255, 255, 0.95);
    min-height: 100vh;
    padding: 2em;
}
.form-container {
    max-width: 600px;
    margin: 0 auto;
}
{% endblock %}

{% block github_link %}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="form-container">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1>🚀 Créer un nouveau Spreadly</h1>
                    <a href="/campaigns" class="btn btn-secondary">← Retour</a>
                </div>
                
                {% if error %}
                    <div class="alert alert-danger" role="alert">
                        {{ error }}
                    </div>
                {% endif %}
                
                {% if success %}
                    <div class="alert alert-success" role="alert">
                        {{ success }}
                    </div>
                {% endif %}
                
                <div class="card">
                    <div class="card-header">
                        <h5>📝 Informations du Spreadly</h5>
                    </div>
                    <div class="card-body">
                        <form method="POST" action="/campaigns/create">
                            <div class="form-group mb-3">
                                <label for="name">Nom du Spreadly *</label>
                                <input type="text" class="form-control" id="name" name="name" required 
                                       placeholder="Ex: Noël 2024, Saint-Valentin...">
                                <small class="form-text text-muted">Le nom affiché de votre Spreadly</small>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label for="start_date">Date de début *</label>
                                        <input type="datetime-local" class="form-control" id="start_date" name="start_date" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-3">
                                        <label for="end_date">Date de fin *</label>
                                        <input type="datetime-local" class="form-control" id="end_date" name="end_date" required>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="form-group mb-3">
                                <label for="theme">Thème</label>
                                <select class="form-control" id="theme" name="theme">
                                    <option value="nature">🌿 Nature</option>
                                    <option value="christmas">🎄 Noël</option>
                                    <option value="party">🎉 Fête</option>
                                </select>
                            </div>
                            
                            <div class="form-group mb-3">
                                <label for="mail_subject">Sujet de l'email</label>
                                <input type="text" class="form-control" id="mail_subject" name="mail_subject" 
                                       placeholder="Laissez vide pour générer automatiquement">
                                <small class="form-text text-muted">Le sujet des emails envoyés aux destinataires</small>
                            </div>
                            
                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="is_active" name="is_active" checked>
                                <label class="form-check-label" for="is_active">
                                    Spreadly actif
                                </label>
                                <small class="form-text text-muted">Les utilisateurs peuvent envoyer des messages</small>
                            </div>
                            
                            <div class="d-flex justify-content-between">
                                <a href="/campaigns" class="btn btn-secondary">Annuler</a>
                                <button type="submit" class="btn btn-success">🚀 Créer le Spreadly</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 