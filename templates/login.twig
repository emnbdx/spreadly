{% extends "auth-layout.twig" %}

{% block title %}Connexion - Spreadly{% endblock %}

{% block container_width %}500px{% endblock %}

{% block content %}
{% if error %}
    <div class="alert alert-danger mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>{{ error }}
    </div>
{% endif %}

{% if session.info is defined %}
    <div class="alert alert-info mb-4" role="alert">
        <i class="fas fa-info-circle me-2"></i>{{ session.info }}
    </div>
{% endif %}

{% if success and email %}
    <div class="alert alert-success mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>Un code de connexion a été envoyé à votre email !
    </div>
    
    <form method="POST" action="/auth/verify">
        <input type="hidden" name="email" value="{{ email }}">
        
        <div class="mb-4">
            <label for="code" class="form-label">
                <i class="fas fa-key me-2"></i>Code de connexion
            </label>
            <input type="text" id="code" name="code" class="form-control" required 
                   placeholder="Entrez votre code à 6 chiffres" maxlength="6">
        </div>
        
        <div class="d-grid mb-4">
            <button type="submit" class="btn btn-gradient btn-lg">
                <i class="fas fa-sign-in-alt me-2"></i>Se connecter
            </button>
        </div>
    </form>
    
    <div class="text-center">
        <form method="POST" action="/auth/request" class="d-inline">
            <input type="hidden" name="email" value="{{ email }}">
            <button type="submit" class="btn btn-glass">
                <i class="fas fa-redo me-2"></i>Renvoyer le code
            </button>
        </form>
    </div>
{% else %}
    <form method="POST" action="/auth/request">
        <div class="mb-4">
            <label for="email" class="form-label">
                <i class="fas fa-envelope me-2"></i>Adresse email
            </label>
            <input type="email" id="email" name="email" class="form-control" required 
                   value="{{ email ?? '' }}" placeholder="votre@email.com">
        </div>
        
        <div class="d-grid mb-4">
            <button type="submit" class="btn btn-gradient btn-lg">
                <i class="fas fa-paper-plane me-2"></i>Envoyer le code
            </button>
        </div>
    </form>
    
    <div class="text-center">
        <p class="text-white-50 mb-3">Pas encore de compte ?</p>
        <a href="/create-spreadly" class="btn btn-gradient btn-success-gradient">
            <i class="fas fa-rocket me-2"></i>Créer un Spreadly
        </a>
    </div>
{% endif %}

{% endblock %} 