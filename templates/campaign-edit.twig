{% extends "admin-layout.twig" %}

{% block title %}Modifier le Spreadly - Spreadly{% endblock %}

{% block font_size %}16px{% endblock %}

{% block extra_styles %}
.form-container {
    max-width: 800px;
    margin: 0 auto;
}

.form-control:focus {
    background: rgba(255, 255, 255, 0.2);
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 0.2rem rgba(79, 172, 254, 0.25);
    color: var(--text-primary);
}

.form-control::placeholder {
    color: var(--text-muted);
}

.form-text {
    color: var(--text-secondary);
}
{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="section-title">
        <i class="fas fa-edit me-2"></i>Modifier le Spreadly
    </h1>
    <a href="/campaigns" class="btn btn-outline-light">
        <i class="fas fa-arrow-left me-1"></i>Retour
    </a>
</div>

{% if error %}
    <div class="alert alert-danger mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>{{ error }}
    </div>
{% endif %}

<div class="glass-card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-cog me-2"></i>Informations du Spreadly
        </h5>
        <small class="text-muted">
            <i class="fas fa-link me-1"></i>Slug: {{ campaign.slug }}
        </small>
    </div>
    <div class="card-body">
        <form method="POST" action="/campaigns/edit/{{ campaign.id }}">
            <div class="mb-3">
                <label for="name" class="form-label">
                    <i class="fas fa-tag me-2"></i>Nom du Spreadly *
                </label>
                <input type="text" class="form-control" id="name" name="name" required 
                       value="{{ campaign.name }}" placeholder="Ex: Noël 2024, Saint-Valentin...">
                <div class="form-text">
                    <i class="fas fa-info-circle me-1"></i>Le nom affiché de votre Spreadly
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="start_date" class="form-label">
                            <i class="fas fa-play me-2"></i>Date de début *
                        </label>
                        <input type="datetime-local" class="form-control" id="start_date" name="start_date" required
                               value="{{ campaign.start_date|date('Y-m-d\\TH:i') }}">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="end_date" class="form-label">
                            <i class="fas fa-stop me-2"></i>Date de fin *
                        </label>
                        <input type="datetime-local" class="form-control" id="end_date" name="end_date" required
                               value="{{ campaign.end_date|date('Y-m-d\\TH:i') }}">
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label for="theme" class="form-label">
                    <i class="fas fa-palette me-2"></i>Thème
                </label>
                <select class="form-control" id="theme" name="theme">
                    <option value="nature" {{ campaign.theme == 'nature' ? 'selected' : '' }}>🌿 Nature</option>
                    <option value="christmas" {{ campaign.theme == 'christmas' ? 'selected' : '' }}>🎄 Noël</option>
                    <option value="party" {{ campaign.theme == 'party' ? 'selected' : '' }}>🎉 Fête</option>
                </select>
            </div>
            
            <div class="mb-3">
                <label for="mail_subject" class="form-label">
                    <i class="fas fa-envelope me-2"></i>Sujet de l'email
                </label>
                <input type="text" class="form-control" id="mail_subject" name="mail_subject" 
                       value="{{ campaign.mail_subject }}" placeholder="Laissez vide pour générer automatiquement">
                <div class="form-text">
                    <i class="fas fa-info-circle me-1"></i>Le sujet des emails envoyés aux destinataires
                </div>
            </div>
            
            <div class="mb-4">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="is_active" name="is_active" 
                           {{ campaign.is_active ? 'checked' : '' }}>
                    <label class="form-check-label" for="is_active">
                        <i class="fas fa-toggle-on me-2"></i>Spreadly actif
                    </label>
                    <div class="form-text">
                        <i class="fas fa-info-circle me-1"></i>Les utilisateurs peuvent envoyer des messages
                    </div>
                </div>
            </div>
            
            <div class="d-flex justify-content-between">
                <a href="/campaigns" class="btn btn-outline-light">
                    <i class="fas fa-times me-1"></i>Annuler
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save me-2"></i>Sauvegarder
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %} 