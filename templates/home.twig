{% extends "layout.twig" %}

{% block title %}Accueil - Spreadly{% endblock %}

{% block content %}
<div class="container h-100">
    <div class="row h-100">
        <div class="form-container col-12 my-auto">
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">Spreadly : <strong>{{ user.campaign_name }}</strong></span>
                    <div>
                        <span class="text-muted">Bonjour {{ user.name }} !</span>
                        <form method="POST" action="/auth/logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Déconnexion</button>
                        </form>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a href="/campaigns" class="btn btn-outline-info btn-sm">Mes Spreadly</a>
                    <a href="/create-spreadly" class="btn btn-outline-success btn-sm">➕ Nouveau Spreadly</a>
                    {% if is_admin %}
                        <button class="btn btn-outline-secondary btn-sm" onclick="copyShareLink()" title="Partager le lien du Spreadly">
                            📋 Partager
                        </button>
                        <a href="/admin" class="btn btn-outline-primary btn-sm">Administration</a>
                    {% endif %}
                </div>
            </div>
            
            {% if error %}
                <div class="alert alert-danger" role="alert">
                    {{ error }}
                </div>
            {% endif %}
            
            {% if success %}
                <div class="alert alert-success" role="alert">
                    {{ success }}
                </div>
            {% endif %}
            
            {% if is_ended %}
                <div class="alert alert-warning text-center" role="alert">
                    <h4>La période d'envoi de messages est terminée</h4>
                    <p>Merci à tous pour votre participation !</p>
                </div>
            {% else %}
                <form method="POST" action="/send" id="loveForm">
                    <input type="hidden" id="message_id" name="message_id" value="">
                    
                    <div class="form-group">
                        <label for="to">À qui voulez-vous envoyer du love ?</label>
                        <select id="to" name="to" class="form-control" required onchange="loadExistingMessage()">
                            <option value="">Choisissez un destinataire...</option>
                            {% for receiver in receivers %}
                                <option value="{{ receiver.id }}" data-has-message="{{ messages_by_receiver[receiver.id] ? 'true' : 'false' }}">
                                    {{ receiver.name }}
                                    {% if messages_by_receiver[receiver.id] %}
                                        ✉️ (message envoyé)
                                    {% endif %}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <div class="d-flex justify-content-between align-items-center">
                            <label for="message">Votre message</label>
                            <div id="messageActions" style="display: none;">
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteMessage()" title="Supprimer le message">
                                    🗑️ Supprimer
                                </button>
                            </div>
                        </div>
                        <textarea id="message" name="message" class="form-control" rows="4" placeholder="Écrivez votre message d'amour ici..." required></textarea>
                        <small id="messageStatus" class="form-text text-muted"></small>
                    </div>
                    
                    <div class="form-group text-center">
                        <input type="submit" id="submitBtn" value="Envoyer du love ❤️" class="btn btn-primary btn-lg">
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
</div>

<script>
// Données des messages existants
const messagesByReceiver = {{ messages_by_receiver|json_encode|raw }};

function loadExistingMessage() {
    const select = document.getElementById('to');
    const messageTextarea = document.getElementById('message');
    const messageIdInput = document.getElementById('message_id');
    const submitBtn = document.getElementById('submitBtn');
    const messageStatus = document.getElementById('messageStatus');
    const messageActions = document.getElementById('messageActions');
    
    const receiverId = select.value;
    
    if (receiverId && messagesByReceiver[receiverId]) {
        // Il y a un message existant
        const existingMessage = messagesByReceiver[receiverId];
        messageTextarea.value = existingMessage.content;
        messageIdInput.value = existingMessage.id;
        submitBtn.value = 'Modifier le message ✏️';
        messageStatus.textContent = 'Vous modifiez un message existant envoyé le ' + 
            new Date(existingMessage.created_at).toLocaleDateString('fr-FR');
        messageStatus.className = 'form-text text-info';
        messageActions.style.display = 'block';
    } else {
        // Nouveau message
        messageTextarea.value = '';
        messageIdInput.value = '';
        submitBtn.value = 'Envoyer du love ❤️';
        messageStatus.textContent = '';
        messageActions.style.display = 'none';
    }
}

function deleteMessage() {
    const messageIdInput = document.getElementById('message_id');
    const messageId = messageIdInput.value;
    
    if (messageId && confirm('Êtes-vous sûr de vouloir supprimer ce message ?')) {
        // Créer un formulaire pour la suppression
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/message/delete/' + messageId;
        document.body.appendChild(form);
        form.submit();
    }
}

function copyShareLink() {
    const shareUrl = window.location.origin + '/campaigns/{{ user.campaign_slug }}';
    
    if (navigator.clipboard && window.isSecureContext) {
        // API moderne
        navigator.clipboard.writeText(shareUrl).then(() => {
            showToast('Lien copié dans le presse-papiers ! 📋');
        }).catch(() => {
            fallbackCopyTextToClipboard(shareUrl);
        });
    } else {
        // Fallback pour les navigateurs plus anciens
        fallbackCopyTextToClipboard(shareUrl);
    }
}

function fallbackCopyTextToClipboard(text) {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    textArea.style.top = "0";
    textArea.style.left = "0";
    textArea.style.position = "fixed";
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    
    try {
        document.execCommand('copy');
        showToast('Lien copié dans le presse-papiers ! 📋');
    } catch (err) {
        showToast('Impossible de copier le lien automatiquement. URL: ' + text);
    }
    
    document.body.removeChild(textArea);
}

function showToast(message) {
    // Créer un toast moderne avec glass morphism
    const toastHtml = `
        <div class="modern-toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-content">
                <div class="toast-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="toast-message">
                    ${message}
                </div>
                <button type="button" class="toast-close" onclick="this.parentElement.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    `;
    
    // Ajouter le toast au DOM
    let toastContainer = document.getElementById('toast-container');
    if (!toastContainer) {
        toastContainer = document.createElement('div');
        toastContainer.id = 'toast-container';
        toastContainer.className = 'toast-container';
        toastContainer.innerHTML = `
            <style>
                .toast-container {
                    position: fixed;
                    top: 20px;
                    right: 20px;
                    z-index: 9999;
                    max-width: 400px;
                }
                
                .modern-toast {
                    background: rgba(255, 255, 255, 0.25);
                    backdrop-filter: blur(20px);
                    -webkit-backdrop-filter: blur(20px);
                    border-radius: 15px;
                    border: 1px solid rgba(255, 255, 255, 0.3);
                    box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);
                    margin-bottom: 15px;
                    animation: slideInRight 0.3s ease-out, fadeOutRight 0.3s ease-in 3.5s forwards;
                    overflow: hidden;
                    position: relative;
                }
                
                .modern-toast::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
                }
                
                .toast-content {
                    display: flex;
                    align-items: center;
                    padding: 15px 20px;
                    gap: 12px;
                }
                
                .toast-icon {
                    color: #4facfe;
                    font-size: 20px;
                    flex-shrink: 0;
                }
                
                .toast-message {
                    color: white;
                    font-weight: 500;
                    flex: 1;
                    font-size: 14px;
                }
                
                .toast-close {
                    background: none;
                    border: none;
                    color: rgba(255, 255, 255, 0.7);
                    cursor: pointer;
                    padding: 5px;
                    border-radius: 50%;
                    transition: all 0.2s ease;
                    flex-shrink: 0;
                }
                
                .toast-close:hover {
                    background: rgba(255, 255, 255, 0.1);
                    color: white;
                    transform: scale(1.1);
                }
                
                @keyframes slideInRight {
                    from {
                        transform: translateX(100%);
                        opacity: 0;
                    }
                    to {
                        transform: translateX(0);
                        opacity: 1;
                    }
                }
                
                @keyframes fadeOutRight {
                    to {
                        transform: translateX(100%);
                        opacity: 0;
                    }
                }
                
                @media (max-width: 768px) {
                    .toast-container {
                        top: 10px;
                        right: 10px;
                        left: 10px;
                        max-width: none;
                    }
                    
                    .modern-toast {
                        margin-bottom: 10px;
                    }
                    
                    .toast-content {
                        padding: 12px 15px;
                    }
                }
            </style>
        `;
        document.body.appendChild(toastContainer);
    }
    
    toastContainer.insertAdjacentHTML('beforeend', toastHtml);
    
    // Supprimer automatiquement le toast après 4 secondes
    const toastElement = toastContainer.lastElementChild;
    setTimeout(() => {
        if (toastElement && toastElement.parentNode) {
            toastElement.remove();
        }
    }, 4000);
}
</script>
{% endblock %} 