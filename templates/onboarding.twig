{% extends "auth-layout.twig" %}

{% block title %}{% if is_logged_in %}Créer un nouveau Spreadly{% else %}Créer un Spread the love{% endif %} - Spread the love{% endblock %}

{% block container_width %}900px{% endblock %}

{% block header %}
{% if is_logged_in %}
    <div class="brand-logo">🚀</div>
    <div class="brand-subtitle">Créer un nouveau Spreadly</div>
    <div class="alert alert-info mb-4">
        <i class="fas fa-user me-2"></i><strong>Connecté en tant que :</strong> {{ user_name }} ({{ user_email }})
    </div>
{% else %}
    <div class="brand-logo">💌</div>
    <div class="brand-subtitle">Créer votre Spreadly</div>
{% endif %}
{% endblock %}

{% block content %}
{% if error %}
    <div class="alert alert-danger mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>{{ error }}
    </div>
{% endif %}

{% if success %}
    <div class="alert alert-success mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>{{ success }}
    </div>
{% endif %}

<form method="POST" action="/create-spreadly">
    <!-- Section Spreadly -->
    <div class="section-header">
        <h4 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Informations du Spreadly</h4>
    </div>
    
    <div class="row mb-4">
        <div class="col-12">
            <label for="campaign_name" class="form-label">
                <i class="fas fa-tag me-2"></i>Nom de votre Spreadly
            </label>
            <input type="text" class="form-control" id="campaign_name" name="campaign_name" required 
                   value="{{ campaign_name }}" placeholder="Ex: Noël en famille, Saint-Valentin...">
            <div class="form-text text-white-50">Le nom qui apparaîtra sur votre Spreadly</div>
        </div>
    </div>
    
    <div class="row mb-4">
        <div class="col-md-6">
            <label for="start_date" class="form-label">
                <i class="fas fa-play me-2"></i>Date de début
            </label>
            <input type="datetime-local" class="form-control" id="start_date" name="start_date" required
                   value="{{ start_date }}">
        </div>
        <div class="col-md-6">
            <label for="end_date" class="form-label">
                <i class="fas fa-stop me-2"></i>Date de fin
            </label>
            <input type="datetime-local" class="form-control" id="end_date" name="end_date" required
                   value="{{ end_date }}">
        </div>
    </div>
    
    <div class="row mb-4">
        <div class="col-12">
            <label for="theme" class="form-label">
                <i class="fas fa-palette me-2"></i>Thème
            </label>
            <select class="form-control" id="theme" name="theme">
                <option value="nature">🌿 Nature</option>
                <option value="christmas">🎄 Noël</option>
                <option value="party">🎉 Fête</option>
            </select>
        </div>
    </div>
    
    {% if not is_logged_in %}
        <!-- Section Utilisateur (seulement pour les nouveaux utilisateurs) -->
        <div class="section-header">
            <h4 class="mb-0"><i class="fas fa-user me-2"></i>Vos Informations</h4>
        </div>
        
        <div class="row mb-4">
            <div class="col-md-6">
                <label for="user_name" class="form-label">
                    <i class="fas fa-id-card me-2"></i>Votre nom complet
                </label>
                <input type="text" class="form-control" id="user_name" name="user_name" required 
                       value="{{ user_name }}" placeholder="Votre nom et prénom">
                <div class="form-text text-white-50">Vous serez l'administrateur de ce Spreadly</div>
            </div>
            <div class="col-md-6">
                <label for="user_email" class="form-label">
                    <i class="fas fa-envelope me-2"></i>Votre adresse email
                </label>
                <input type="email" class="form-control" id="user_email" name="user_email" required 
                       value="{{ user_email }}" placeholder="votre@email.com">
                <div class="form-text text-white-50">Vous recevrez un code de connexion à cette adresse</div>
            </div>
        </div>
    {% endif %}
    
    <div class="d-grid mb-4">
        <button type="submit" class="btn btn-gradient btn-success-gradient btn-lg">
            {% if is_logged_in %}
                <i class="fas fa-plus me-2"></i>Créer un nouveau Spreadly
            {% else %}
                <i class="fas fa-rocket me-2"></i>Créer mon Spreadly
            {% endif %}
        </button>
    </div>
</form>

<div class="text-center">
    {% if is_logged_in %}
        <a href="/campaigns" class="btn btn-glass me-2">
            <i class="fas fa-list me-2"></i>Mes Spreadly
        </a>
        <a href="{% if is_logged_in %}/campaigns{% else %}/{% endif %}" class="btn btn-outline-glass">
            <i class="fas fa-home me-2"></i>Retour à l'accueil
        </a>
    {% else %}
        <p class="text-white-50 mb-2" style="font-size: 0.95rem;">Déjà un compte ?</p>
        <a href="/?login=1" style="color: rgba(255, 255, 255, 0.9); text-decoration: underline; font-size: 0.95rem;">
            <i class="fas fa-sign-in-alt me-1"></i>Se connecter
        </a>
    {% endif %}
</div>
{% endblock %} 