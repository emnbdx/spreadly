{% extends "admin-layout.twig" %}

{% block title %}Modifier l'utilisateur - Spreadly{% endblock %}

{% block font_size %}16px{% endblock %}

{% block extra_styles %}
.form-check-input:checked {
    background-color: var(--accent-primary);
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 0.2rem rgba(79, 172, 254, 0.25);
}

.form-check-input {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: var(--glass-border);
}

.form-check-label {
    color: var(--text-secondary);
}
{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="section-title">
        <i class="fas fa-user-edit me-2"></i>Modifier l'utilisateur
    </h1>
    <div>
        <a href="/admin" class="btn btn-outline-light">
            <i class="fas fa-arrow-left me-1"></i>Retour à l'administration
        </a>
    </div>
</div>

{% if error %}
    <div class="alert alert-danger mb-4" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>{{ error }}
    </div>
{% endif %}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="glass-card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-user me-2"></i>Modifier {{ user.name }}
                </h5>
            </div>
            <div class="card-body">
                <form method="POST" action="/admin/edit/{{ user.user_id }}">
                    <div class="mb-3">
                        <label for="name" class="form-label">
                            <i class="fas fa-user me-2"></i>Nom
                        </label>
                        <input type="text" id="name" name="name" class="form-control" value="{{ user.name }}" required
                               placeholder="Nom complet">
                    </div>
                    
                    <div class="mb-3">
                        <label for="email" class="form-label">
                            <i class="fas fa-envelope me-2"></i>Email
                        </label>
                        <input type="email" id="email" name="email" class="form-control" value="{{ user.email }}" required
                               placeholder="adresse@email.com">
                    </div>
                    
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="receiver" name="receiver" {{ user.receiver ? 'checked' : '' }}>
                            <label class="form-check-label" for="receiver">
                                <i class="fas fa-inbox me-2"></i>Peut recevoir des messages
                            </label>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="admin" name="admin" {{ is_admin ? 'checked' : '' }}>
                            <label class="form-check-label" for="admin">
                                <i class="fas fa-user-shield me-2"></i>Administrateur
                            </label>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="/admin" class="btn btn-outline-light me-md-2">
                            <i class="fas fa-times me-1"></i>Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Modifier l'utilisateur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %} 